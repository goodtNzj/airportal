{
  "name": "airportal",
  "version": "1.0.0",
  "private": true,
  "description": "AirPortal - 简单安全的文件传输应用",
  "scripts": {
    "dev": "pnpm -r run dev",
    "dev:server": "pnpm --filter @airportal/server dev",
    "dev:web": "pnpm --filter @airportal/web dev",
    "build": "pnpm -r run build",
    "test": "pnpm --filter @airportal/server test && pnpm --filter @airportal/web test",
    "test:server": "pnpm --filter @airportal/server test",
    "test:web": "pnpm --filter @airportal/web test",
    "test:coverage": "pnpm --filter @airportal/server test:coverage && pnpm --filter @airportal/web test:coverage",
    "db:push": "pnpm --filter @airportal/server db:push",
    "db:generate": "pnpm --filter @airportal/server db:generate",
    "start": "pnpm --filter @airportal/server start"
  },
  "keywords": ["airportal", "file-transfer", "transfer"],
  "author": "",
  "license": "MIT"
}
