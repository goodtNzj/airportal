# 服务配置
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# 反向代理：仅在部署于 Nginx/Caddy 等反向代理之后时设为 true
# 开启后信任 X-Forwarded-For 头获取真实 IP，否则可能被伪造绕过 IP 黑名单
TRUST_PROXY=false

# 数据库
DATABASE_URL=file:./data/airportal.db

# JWT 密钥（生产环境请更换）
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# 文件存储
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
MAX_TEXT_LENGTH=10000

# 取件码配置
CODE_LENGTH=6
DEFAULT_EXPIRY=180
MAX_EXPIRY=3600

# 清理配置
CLEANUP_INTERVAL=60
CLEANUP_ON_START=true
CLEANUP_FILES=true
CLEANUP_RECORDS=true
CLEANUP_RECORD_ACTION=update

# 日志配置
LOG_LEVEL=info
LOG_FILE=

# 限流配置
RATE_LIMIT_MAX=100
RATE_LIMIT_UPLOAD=10

# 认证端点限流（5 次/分钟/IP）
AUTH_RATE_MAX=5
AUTH_RATE_WINDOW=60000
# 账户锁定：连续 5 次失败后锁定 5 分钟
AUTH_LOCK_THRESHOLD=5
AUTH_LOCK_WINDOW=300000
AUTH_LOCK_DURATION=300000

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# 存储配额（字节，默认 1GB）
MAX_TOTAL_STORAGE=1073741824

# ==================== 文件夹上传配置 ====================

FOLDER_UPLOAD_ENABLED=true
# ZIP 解压后最大大小（压缩前，默认 500MB）
ZIP_MAX_UNCOMPRESSED_SIZE=524288000
# ZIP 压缩后最大大小（上传的 ZIP 文件大小，默认 300MB）
ZIP_MAX_COMPRESSED_SIZE=314572800
# 最大压缩比（解压/压缩），超过视为 ZIP 炸弹
ZIP_MAX_COMPRESSION_RATIO=100
# ZIP 内最大文件条目数
ZIP_MAX_ENTRIES=10000
# ZIP 内文件名最大长度
ZIP_MAX_FILENAME_LENGTH=512

# ==================== 安全插件配置 ====================

# 安全插件系统总开关
SECURITY_PLUGIN_ENABLED=true

# 启发式扫描器
HEURISTIC_ENABLED=true
# 信息熵阈值（>7.5 表示加密/混淆/打包内容）
HEURISTIC_ENTROPY_THRESHOLD=7.5
# 最大扫描大小（字节，默认 10MB）
HEURISTIC_MAX_SCAN_SIZE=10485760
# 拒绝阈值（风险分数 >= 此值 → 拒绝上传）
HEURISTIC_REJECT_THRESHOLD=70
# 警告阈值（风险分数 >= 此值 → 记录警告日志）
HEURISTIC_WARN_THRESHOLD=40

# 行为追踪器
BEHAVIOR_ENABLED=true
# 滑动时间窗口（毫秒）
BEHAVIOR_WINDOW_MS=60000
# 突发上传阈值（窗口内上传次数 >= 此值 → 异常）
BEHAVIOR_BURST_THRESHOLD=5
# 文件大小异常倍数（超过该 IP 平均值 * 倍数 → 异常）
BEHAVIOR_SIZE_MULTIPLIER=3
# 异常分数阈值（>= 此值 → 触发 IP 封禁计数）
BEHAVIOR_ANOMALY_THRESHOLD=50

# ==================== 安全配置 ====================

# 文件类型深度检测（Magic Number 验证）
FILE_VALIDATION=true

# IP 黑名单
IP_BLACKLIST_ENABLED=true
# 自动封禁阈值（失败次数）
IP_AUTO_BLOCK_THRESHOLD=10
# 自动封禁时间窗口（秒）
IP_AUTO_BLOCK_WINDOW=60
# 自动封禁时长（秒），0 表示永久
IP_AUTO_BLOCK_DURATION=3600
# 最大 IP 记录数，超过后淘汰最旧的非封禁记录
IP_MAX_RECORDS=10000
# IP 白名单（逗号分隔）
IP_WHITELIST=127.0.0.1,::1
# IP 黑名单（逗号分隔）
IP_BLACKLIST=

# 审计日志
AUDIT_LOG=true

# 上传限流（更严格）
UPLOAD_RATE_MAX=10
UPLOAD_RATE_WINDOW=60000

# ==================== P2P 配置 ====================

# P2P 功能开关
P2P_ENABLED=true
# P2P 最大文件大小（字节，默认 500MB）
P2P_MAX_FILE_SIZE=524288000
# 最大并发传输数
P2P_MAX_CONCURRENT=3
# 传输请求超时（毫秒）
P2P_REQUEST_TIMEOUT=60000

# ICE 服务器配置（WebRTC 连接建立）
# STUN 服务器（用于 NAT 穿透，可配置多个，逗号分隔）
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN 服务器（当 NAT 穿透失败时作为中转，需配置完整）
# TURN_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=your-username
# TURN_CREDENTIAL=your-password
# 或者使用 TURNS（TLS 加密连接）:
# TURN_URL=turns:your-turn-server.com:5349

# ==================== Prometheus 指标导出 ====================

# 是否启用 Prometheus 指标导出（true/false）
METRICS_ENABLED=true
# 指标导出路径（默认值 /metrics）
METRICS_PATH=/metrics
# 是否同时采集 Node.js 运行时默认指标（CPU/内存/Event Loop/GC）
METRICS_COLLECT_NODE=true
# 是否允许未登录访问指标端点（公网暴露时请配合 nginx ACL 限制来源）
METRICS_PUBLIC=false
